# Copy to .env and fill in.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Optional infra
REDIS_URL=
DATABASE_URL=postgresql://alpha:alpha@localhost:5432/alphaengine

# Optional alerting
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# Optional sentiment data
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=

# TradingView webhook (set this to a long random string and use the same value in your TV alert payload)
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_IP_CHECK=0
SEC_USER_AGENT=AlphaEngine you@example.com
